#version 330 core

layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec4 vertexColor;
layout(location = 2) in vec2 vertexUV;

out vec4 fragColor;
out vec2 fragUV;

uniform mat4 MVP;

void main()
{
 
    gl_Position = MVP * vec4(vertexPosition_modelspace, 1.0);

    fragColor = vertexColor;

    fragUV = vertexUV;
}
